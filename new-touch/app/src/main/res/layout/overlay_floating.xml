<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <View
            android:id="@+id/ring"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_ring" />

        <FrameLayout
            android:id="@+id/bubble"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_gradient_circle">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo_mark" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_menu"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_menu_btn"
            android:contentDescription="Iniciar ou pausar"
            android:padding="10dp"
            android:src="@drawable/ic_play" />

        <ImageView
            android:id="@+id/btnStopAll"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_menu_btn"
            android:contentDescription="Encerrar"
            android:padding="10dp"
            android:src="@drawable/ic_stop" />

        <ImageView
            android:id="@+id/btnOpenApp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_menu_btn"
            android:contentDescription="Abrir configurações"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>
</LinearLayout>
